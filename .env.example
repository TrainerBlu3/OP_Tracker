# Copy to .env and fill in.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/op_tracker?schema=public"

# Auth.js session encryption secret. Generate one with:
#   npx auth secret
# or: openssl rand -base64 33
AUTH_SECRET=""

# Base URL this app is served from (used by Auth.js for callback URLs).
# Local dev: http://localhost:3000
# Production: https://your-domain-or-ip
AUTH_URL="http://localhost:3000"

# API key from https://apitcg.com, used by scripts/sync-cards.ts to pull
# One Piece TCG card data. Not required to run the app itself -- only to
# sync/refresh the card catalog.
APITCG_API_KEY=""
