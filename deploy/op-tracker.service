# Runs the Next.js production server.
# Install as a systemd --user unit (see deploy/README.md):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/op-tracker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now op-tracker
#
# Port 3001, not 3000 -- if this VM also runs another app (e.g. QuickDash,
# which defaults to 3000) alongside this one, they'd otherwise collide.
# Change it back to 3000 (and update deploy/Caddyfile's proxy target to
# match) if this is the only app on the VM.

[Unit]
Description=OP Tracker web app
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/op-tracker
EnvironmentFile=%h/op-tracker/.env
ExecStart=/usr/bin/env npm run start -- --port 3001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
